{
  "name": "lucio-discord",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de música ligero para Discord",
  "license": "MIT",
  "homepage": "https://github.com/sebasgrios/lucio-discord",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebasgrios/lucio-discord.git"
  },
  "bugs": {
    "url": "https://github.com/sebasgrios/lucio-discord/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsup src/server/index.ts src/server/register-commands.ts --format esm --out-dir dist/server --clean --sourcemap",
    "build:web": "vite build",
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node --enable-source-maps dist/server/index.js",
    "commands:deploy": "tsx src/server/register-commands.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "audit": "pnpm audit --audit-level low",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.22.1",
    "fastify": "^5.6.1",
    "pino": "^9.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ulid": "^3.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "railway": "^3.11.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
