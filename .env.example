NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./lucio.db

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DEV_GUILD_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Registra PUBLIC_BASE_URL + /auth/spotify/callback en Spotify Developer Dashboard.

YTDLP_PATH=yt-dlp
# Caché opcional de yt-dlp. En Railway se conserva dentro del volumen /data.
YTDLP_CACHE_DIR=
# Ruta local opcional a un archivo de cookies Netscape exportado para youtube.com.
YTDLP_COOKIES_PATH=
# Alternativa para Railway: contenido del mismo archivo codificado en Base64.
YOUTUBE_COOKIES_BASE64=
FFMPEG_PATH=ffmpeg
